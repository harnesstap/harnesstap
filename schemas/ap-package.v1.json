{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harnesstap.com/schemas/ap-package.v1.json",
  "title": "HarnessTap Agent Plugins package envelope",
  "description": "Wire format for catalog publish and download: { schema, files } with schema urn:harnesstap:ap-package:v1. plugin.json inside files.content may omit $schema; catalog consumers default it. Publish still requires and emits $schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "files"],
  "properties": {
    "schema": {
      "const": "urn:harnesstap:ap-package:v1"
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "required": ["plugin.json"],
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["encoding", "content"],
        "properties": {
          "encoding": {
            "enum": ["utf8", "base64"]
          },
          "content": {
            "type": "string"
          }
        }
      }
    }
  }
}
