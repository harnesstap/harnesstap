{
  "name": "harnesstap",
  "version": "0.1.0",
  "description": "Agent harness configuration toolkit for Claude Code, Codex, Cursor, and other coding CLIs",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "harnesstap": "./dist/index.js",
    "ht": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "build:sidecar": "bun build --compile src/agent/entry.ts --outfile dist/sidecar/ht-agent",
    "desktop:cleanup": "bash apps/desktop/scripts/cleanup-stale-dev.sh",
    "desktop:prepare-sidecar": "bash apps/desktop/scripts/prepare-sidecar.sh",
    "desktop:watch-sidecar": "bun apps/desktop/scripts/watch-sidecar.ts",
    "desktop:icons": "cd apps/desktop && bun run icons",
    "desktop:dev": "bash apps/desktop/scripts/desktop-dev.sh",
    "desktop:build": "bun run desktop:prepare-sidecar && cd apps/desktop && bun install && bun run tauri build",
    "dev": "tsup --watch",
    "start": "bun src/index.ts",
    "start:dist": "node dist/index.js",
    "link": "bun run build && bun link",
    "unlink": "bun unlink",
    "test": "bun test",
    "test:run": "bun test --dots",
    "test:core": "bun test --dots test/models test/db test/config test/utils",
    "test:platforms": "bun test --dots test/platforms",
    "test:plugins": "bun test --dots test/plugins",
    "test:services": "bun test --dots test/services test/integration",
    "test:cli": "bun test --dots test/cli test/ui test/helpers",
    "test:docs": "bun test --dots test/docs",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write --unsafe .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "preflight": "bun run lint && bun run typecheck && bun run test:run && bun run build",
    "prepublishOnly": "bun run build",
    "docs:vhs": "bash scripts/generate-vhs-scenarios.sh",
    "check:scenario-docs": "bash scripts/check-scenario-docs.sh",
    "check:scenario-smoke": "bun test test/cli/scenario-smoke.test.ts",
    "check:sqlite-wal-smoke": "bun scripts/sqlite-wal-write-smoke.ts",
    "sync:cloud-docs": "bash scripts/sync-cloud-cli-docs.sh"
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "cli",
    "configuration",
    "claude-code",
    "cursor",
    "codex",
    "skills",
    "layers"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harnesstap/harnesstap.git"
  },
  "bugs": {
    "url": "https://github.com/harnesstap/harnesstap/issues"
  },
  "homepage": "https://github.com/harnesstap/harnesstap#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@inquirer/core": "^10.3.2",
    "@inquirer/search": "^3.2.2",
    "better-sqlite3": "^11.7.0",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "gray-matter": "^4.0.3",
    "inquirer": "^12.3.0",
    "jsonc-parser": "^3.3.1",
    "ora": "^9.4.0",
    "picomatch": "^4.0.2",
    "semver": "^7.8.0",
    "smol-toml": "^1.3.1",
    "ulid": "^2.3.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@inquirer/testing": "^3.3.8",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/semver": "^7.7.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0"
  }
}
