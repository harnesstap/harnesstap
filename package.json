{
  "name": "harnessdeck",
  "version": "0.1.0",
  "description": "Preset-based AI coding assistant configuration manager for Claude Code, Codex, Cursor, and other coding CLIs",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "bin": {
    "harnessdeck": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "bun src/index.ts",
    "start:dist": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "preflight": "bun run lint && bun run typecheck && bun run test:run && bun run build",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "cli",
    "configuration",
    "claude-code",
    "cursor",
    "codex",
    "skills",
    "presets"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "gray-matter": "^4.0.3",
    "inquirer": "^12.3.0",
    "picomatch": "^4.0.2",
    "semver": "^7.8.0",
    "smol-toml": "^1.3.1",
    "ulid": "^2.3.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/semver": "^7.7.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
