{
  "name": "skillset",
  "version": "0.1.0",
  "description": "Unified AI coding assistant configuration manager — manage, align, and share presets across Claude Code, Codex, Cursor, and 40+ coding CLIs",
  "type": "module",
  "bin": {
    "skillset": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "cli",
    "configuration",
    "claude-code",
    "cursor",
    "codex",
    "skills",
    "presets"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "gray-matter": "^4.0.3",
    "inquirer": "^12.3.0",
    "picomatch": "^4.0.2",
    "smol-toml": "^1.3.1",
    "ulid": "^2.3.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
